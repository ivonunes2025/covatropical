---
import { menuData } from '../data/menu';
const DAY_IDS = ['segunda', 'terca', 'quarta', 'quinta', 'sexta', 'sabado'];
---

<section id="menu" class="menu-section">
    <div class="menu-bg-pattern"></div>
    <div class="container">
        <!-- Cabeçalho (Header) do Menu: Animado com fade-down (desliza de cima) -->
        <div class="section-header section-header--dark" data-aos="fade-down">
            <span class="section-tag section-tag--dark">A Nossa Ementa Diária</span>
            <h2 style="color:#fff">Tudo feito no dia,<br><em>com ingredientes frescos</em></h2>
            <p class="section-desc" style="color:rgba(255,255,255,.6)">Escolha o dia e veja os pratos disponíveis.</p>
        </div>

        <!-- Abas dos Dias: Surgem todas juntas com um delay após o título -->
        <div class="day-tabs" role="tablist" data-aos="zoom-in" data-aos-delay="200">
            <button class="day-tab" role="tab" data-day="segunda">Seg</button>
            <button class="day-tab" role="tab" data-day="terca">Ter</button>
            <button class="day-tab" role="tab" data-day="quarta">Qua</button>
            <button class="day-tab" role="tab" data-day="quinta">Qui</button>
            <button class="day-tab" role="tab" data-day="sexta">Sex</button>
            <button class="day-tab" role="tab" data-day="sabado">Sáb</button>
        </div>

        {DAY_IDS.map((dayId: string) => (
            <div id={`panel-${dayId}`} class="day-panel" role="tabpanel">
                <div class="menu-board">
                    <h3 class="menu-board-welcome">Bem-vindo à Cova Tropical</h3>
                    
                    <div class="menu-board-body">
                        <h4 class="day-title-center">
                            Menu do dia de {dayId === 'segunda' ? 'Segunda-feira' : dayId === 'terca' ? 'Terça-feira' : dayId === 'quarta' ? 'Quarta-feira' : dayId === 'quinta' ? 'Quinta-feira' : dayId === 'sexta' ? 'Sexta-feira' : 'Sábado'}
                        </h4>
                        
                        <ul class="dish-list-center">
                            {menuData.filter(dish => dish.day === dayId).map((dish) => (
                                <li>{dish.name}</li>
                            ))}
                        </ul>
                        
                        <p class="other-dishes-center">Entre outros pratos</p>
                    </div>

                    <div class="menu-board-footer">
                        <strong>Nota:</strong> Todos os dias ao jantar, servimos o nosso especial <em>Bife à Cova</em> (opções de lombo, vitela, frango ou peru).<br>
                        Preço médio: 5€ a 10€ por pessoa.
                    </div>
                    
                    <div class="menu-board-concept">
                        Mais do que um restaurante, é onde Felgueiras almoça.<br>
                        <strong>O conceito é de self-service e take-away.</strong>
                    </div>
                </div>
            </div>
        ))}

    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const DAY_IDS = ['segunda', 'terca', 'quarta', 'quinta', 'sexta', 'sabado'];

        function switchDay(dayId) {
            DAY_IDS.forEach(id => {
                const panel = document.getElementById('panel-' + id);
                if (panel) panel.classList.remove('active');
            });

            document.querySelectorAll('.day-tab').forEach(tab => {
                tab.classList.remove('active');
            });

            const targetPanel = document.getElementById('panel-' + dayId);
            const targetTab   = document.querySelector('.day-tab[data-day="' + dayId + '"]');

            if (targetPanel) {
                targetPanel.classList.add('active');
                const carousel = targetPanel.querySelector('.dishes-carousel');
                if (carousel) carousel.scrollLeft = 0;
            }
            if (targetTab) targetTab.classList.add('active');
        }



        document.querySelectorAll('.day-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                const day = this.getAttribute('data-day');
                if (day) switchDay(day);
            });
        });

        function setTodayTab() {
            const dayMap = {
                1: 'segunda',
                2: 'terca',
                3: 'quarta',
                4: 'quinta',
                5: 'sexta',
                6: 'sabado'
            };

            const todayIndex = new Date().getDay();
            const todayId    = dayMap[todayIndex] || 'segunda';

            switchDay(todayId);
        }

        setTodayTab();
    });
</script>

<style>
.menu-section {
    position: relative;
    background-image: linear-gradient(rgba(244, 244, 244, 0.90), rgba(244, 244, 244, 0.93)), url('/carro.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    padding: 7rem 0 8rem;
    overflow: hidden;
}

.menu-bg-pattern {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 15% 50%, rgba(139,0,33,.06) 0%, transparent 50%),
        radial-gradient(circle at 85% 20%, rgba(46,158,86,.1) 0%, transparent 40%);
    pointer-events: none;
}

.day-tabs {
    display: flex;
    gap: .5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
}

.day-tab {
    background: var(--white);
    border: 1px solid var(--neutral-200);
    color: var(--text-mid);
    padding: .6rem 1.6rem;
    border-radius: 50px;
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: .88rem;
    transition: all .25s var(--ease);
    letter-spacing: .02em;
}

.day-tab:hover {
    background: var(--neutral-100);
    color: var(--text);
}

.day-tab.active {
    background: var(--neutral-900);
    border-color: var(--neutral-900);
    color: #fff;
    box-shadow: 0 6px 22px rgba(0,0,0,.2);
    position: relative;
}

.day-tab.active::after {
    content: '';
    position: absolute;
    top: -3px;
    right: 12px;
    width: 6px;
    height: 6px;
    background: var(--green-600);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--cream);
}

.day-panel { display: none; }
.day-panel.active { display: block; }

.menu-board {
    background: #fff;
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 4rem;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
    text-align: center;
    border-top: 8px solid var(--green-600);
    animation: menuFadeUp .4s var(--ease) both;
}

@keyframes menuFadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
}

.menu-board-welcome {
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    color: var(--neutral-900);
    margin-bottom: 2rem;
    font-weight: 700;
}

.menu-board-body {
    margin-bottom: 2rem;
}

.day-title-center {
    text-align: center;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--green-600);
    margin-bottom: 1.5rem;
    text-transform: capitalize;
    border-bottom: 2px solid var(--neutral-100);
    padding-bottom: 0.5rem;
    max-width: 300px;
    margin-left: auto;
    margin-right: auto;
}

.dish-list-center {
    text-align: center;
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
}

.dish-list-center li {
    font-size: 1.15rem;
    color: var(--text);
    margin-bottom: 1rem;
    font-weight: 500;
}

.dish-list-center li::before {
    content: '• ';
    color: var(--green-600);
    font-size: 1.5rem;
    line-height: 1;
    vertical-align: middle;
}

.other-dishes-center {
    text-align: center;
    font-style: italic;
    color: var(--text-mid);
    font-size: 1.1rem;
    margin-top: 1.5rem;
    font-weight: 500;
}

.menu-board-footer {
    background: var(--neutral-50);
    padding: 1.5rem;
    border-radius: 8px;
    font-size: 0.95rem;
    color: var(--text-mid);
    line-height: 1.6;
    border: 1px dashed var(--neutral-200);
    text-align: center;
    margin-bottom: 1.5rem;
}

.menu-board-concept {
    font-size: 1.1rem;
    color: var(--neutral-900);
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid var(--neutral-100);
}

@media (max-width: 768px) {
    .menu-board {
        padding: 2rem 1.5rem;
        margin: 0 1rem;
    }
    .menu-board-welcome {
        font-size: 1.8rem;
    }
    .dish-list-center li {
        font-size: 1.05rem;
    }
}
</style>
