---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página não encontrada — Cova Tropical" description="Oops! Parece que este prato não está na nossa ementa hoje.">
    <!-- Usando o Header novo que criaste -->
    <Header />
    
    <main class="error-page">
        <div class="container container--center">
            <div class="error-content" data-aos="zoom-in">
                <div class="error-visual">
                    <span class="palm">🌴</span>
                    <h1 class="error-code">404</h1>
                </div>
                
                <h2 class="error-title">Prato não <em>encontrado</em>.</h2>
                <p class="error-desc">
                    Pedimos desculpa, mas a página que procura parece ter saído da ementa.<br>
                    Que tal voltar ao início e descobrir as nossas diárias?
                </p>
                
                <div class="error-actions">
                    <a href="/" class="btn-primary">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        Voltar para o Início
                    </a>
                </div>
            </div>
        </div>
    </main>
    
    <Footer />
</Layout>

<style>
    .error-page {
        background: var(--neutral-900);
        background-image: linear-gradient(rgba(10,11,10,0.8), rgba(10,11,10,0.9)), url('/chefe.jpg');
        background-size: cover;
        background-position: center;
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
    }

    .container--center {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .error-visual {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .palm {
        font-size: 4rem;
        display: block;
        animation: sway 3s ease-in-out infinite alternate;
    }

    .error-code {
        font-family: 'Cormorant Garamond', serif;
        font-size: 8rem;
        font-weight: 700;
        line-height: 1;
        margin-top: -1rem;
        color: rgba(255,255,255,0.1);
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        z-index: -1;
    }

    .error-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .error-title em {
        color: var(--green-600);
        font-style: italic;
    }

    .error-desc {
        color: rgba(255,255,255,0.6);
        max-width: 500px;
        margin: 0 auto 2.5rem;
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .error-actions {
        display: flex;
        justify-content: center;
    }

    @keyframes sway {
        0% { transform: rotate(-5deg); }
        100% { transform: rotate(10deg); }
    }
</style>
